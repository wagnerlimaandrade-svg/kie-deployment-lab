FROM docker.io/apache/incubator-kie-sandbox-dev-deployment-quarkus-blank-app:main

USER 0
WORKDIR /home/app

# The upstream runtime starts Quarkus with Maven offline after receiving the
# model ZIP. Populate the repository from the base image's own POM so this
# derivative remains aligned when the mutable :main tag changes versions.
RUN ./mvnw --batch-mode --no-transfer-progress \
      -Dmaven=3.9.11 \
      -s=/tmp/kogito/.m2/settings.xml \
      -Dmaven.repo.local=/tmp/kogito/.m2/repository \
      -DskipTests \
      clean package quarkus:go-offline

# Keep the image compatible with Kubernetes' arbitrary/non-root UID model.
RUN chgrp -R 0 /tmp/kogito/.m2/repository \
 && chmod -R g=u /tmp/kogito/.m2/repository

USER 185
